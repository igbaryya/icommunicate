# Interface and port the LAN server listens on
HOST=0.0.0.0
PORT=4000

# Where the SQLite database and attachments are stored (relative to the repo root or absolute)
STORAGE_DIR=storage

# Maximum size of a single uploaded attachment, in megabytes
MAX_FILE_SIZE_MB=100

# Reject requests coming from non-private (non-LAN) IP addresses
LAN_ONLY=true
